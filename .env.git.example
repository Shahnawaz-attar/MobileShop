# Local GitHub credentials for git push from this machine / Cursor.
# Copy to .env.git and fill in. .env.git is gitignored — never commit it.
# Do not put these on Vercel shop deployments.

# Fine-grained PAT (repo: Contents Read and write) or classic repo scope
GITHUB_TOKEN=""

# Optional — only if git commit has no name/email on this machine
GIT_USER_NAME=""
GIT_USER_EMAIL=""

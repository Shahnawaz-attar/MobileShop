# ============================================
# MobileShop — Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================

# --- Database ---
# One PostgreSQL database per shop deployment
DATABASE_URL="postgresql://user:password@localhost:5432/mobileshop_db"
# Neon: optional override for migrate deploy (else pooler host is auto-converted to direct)
# DIRECT_URL="postgresql://user:password@ep-xxx.c-4.region.aws.neon.tech/neondb?sslmode=require"

# --- Authentication ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-32-char-secret-here-with-openssl"

# --- Application ---
# Local: http://localhost:3000
# Production: site origin only, no /phones and no trailing slash
# Example: https://mobileshop-azure.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cloudinary (Phase 3) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Sentry (Phase 13) ---
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# --- Web Push (stock alerts). Generate: npx web-push generate-vapid-keys ---
# NEXT_PUBLIC_ is baked at build time — redeploy after changing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@example.com"

# --- Analytics ---
# Generate with: openssl rand -hex 16
ANALYTICS_SALT=""

# --- Seed Control ---
# Set to "true" ONLY for initial data seeding. Never in production.
ALLOW_SEED="false"

# --- GitHub push (your laptop / Cursor agent only) ---
# Do NOT add this to Vercel. Copy .env.git.example → .env.git (gitignored).
# Fine-grained PAT: repo contents read/write for Shahnawaz-attar/MobileShop
# GITHUB_TOKEN=""
